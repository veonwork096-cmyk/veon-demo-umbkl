  <span class="logo__text" aria-hidden="true">Ужгородська міська<br /><b>Багатопрофільна</b><br /><b>Клінічна Лікарня</b></span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: .625rem; text-decoration: none; color: var(--color-field); min-height: var(--tap); border-radius: var(--radius-btn); }
  .logo__mark { width: 44px; height: 44px; flex: none; }
  .logo__tri { fill: var(--color-accent); }
  .logo__cross { fill: var(--color-field); }
  .logo__text { font-family: var(--font-body); font-size: .8125rem; line-height: 1.12; letter-spacing: 0; }
  .logo__text b { font-weight: 700; }
  .logo--light { color: var(--color-on-field); }
  .logo--light .logo__cross { fill: var(--color-on-field); }
</style>
