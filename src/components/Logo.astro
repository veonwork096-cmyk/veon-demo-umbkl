    <path class="logo__tri" d="M406.2,173.4A1586.49,1586.49,0,0,1,295.7,295.9,1602.49,1602.49,0,0,1,173.3,406.3H264A650.34,650.34,0,0,1,426.7,427a650,650,0,0,1-20.5-146.3V173.4Z"/>
    <path class="logo__tri" d="M1178.1,173.4V280.7A650,650,0,0,1,1157.6,427a649.16,649.16,0,0,1,162.7-20.7H1411a1602.49,1602.49,0,0,1-122.4-110.4,1586.49,1586.49,0,0,1-110.5-122.5"/>
    <path class="logo__tri" d="M426.7,1158.5A649.16,649.16,0,0,1,264,1179.2H173.3a1621.67,1621.67,0,0,1,122.4,110.4,1586.49,1586.49,0,0,1,110.5,122.5V1304.8a650,650,0,0,1,20.5-146.3"/>
    <path class="logo__tri" d="M1157.6,1158.5a650,650,0,0,1,20.5,146.3v107.3a1586.49,1586.49,0,0,1,110.5-122.5A1602.49,1602.49,0,0,1,1411,1179.2h-90.7a650.34,650.34,0,0,1-162.7-20.7"/>
    <path class="logo__cross" d="M1056.4,0h-.6c-21.4,3.6-42.9,6.7-64.7,9.4A1611.88,1611.88,0,0,1,792.2,21.6a1614.71,1614.71,0,0,1-199-12.2C571.6,6.6,550,3.6,528.6,0h-.5V277.8a523.43,523.43,0,0,0,48.7,208.6q9.9,21.45,21.6,41.8A532.7,532.7,0,0,0,770.9,708.9,656.26,656.26,0,0,1,995.4,493c4-2.3,8.1-4.6,12.2-6.8a526.77,526.77,0,0,0,48.8-222.1V0Z"/>
    <path class="logo__cross" d="M264.1,528.8H0v.6c3.6,21.4,6.7,42.9,9.4,64.7A1611.88,1611.88,0,0,1,21.6,793,1614.71,1614.71,0,0,1,9.4,992c-2.8,21.6-5.8,43.1-9.4,64.5v.5H277.8a523.43,523.43,0,0,0,208.6-48.7q21.45-9.9,41.8-21.6A532.7,532.7,0,0,0,708.9,814.2,655.05,655.05,0,0,1,493.1,589.7c-2.3-4-4.6-8.1-6.8-12.2a526.77,526.77,0,0,0-222.1-48.8"/>
